{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tistory-growth-os:schema:public-blog-inventory:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "classification_version": {"type": "string", "const": "1.1.0"},
    "inventory_id": {"type": "string", "pattern": "^inventory_[0-9a-f]{64}$"},
    "blog_url": {"type": "string", "format": "uri"},
    "checked_date": {"type": "string", "format": "date"},
    "status": {"type": "string", "const": "pass"},
    "post_count": {"type": "integer", "minimum": 1},
    "external_write_count": {"type": "integer", "const": 0},
    "style_analysis_performed": {"type": "boolean", "const": false},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "review_required": {"type": "integer", "minimum": 0},
            "time_sensitive_stale": {"type": "integer", "minimum": 0},
            "evergreen_review_due": {"type": "integer", "minimum": 0}
          },
          "required": ["review_required", "time_sensitive_stale", "evergreen_review_due"]
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "high": {"type": "integer", "minimum": 0},
            "medium": {"type": "integer", "minimum": 0},
            "low": {"type": "integer", "minimum": 0}
          },
          "required": ["high", "medium", "low"]
        },
        "intent_hint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "explanation": {"type": "integer", "minimum": 0},
            "how_to": {"type": "integer", "minimum": 0},
            "schedule": {"type": "integer", "minimum": 0},
            "comparison": {"type": "integer", "minimum": 0}
          },
          "required": ["explanation", "how_to", "schedule", "comparison"]
        }
      },
      "required": ["freshness", "risk", "intent_hint"]
    },
    "posts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "canonical_url": {"type": "string", "format": "uri"},
          "title": {"type": "string", "minLength": 1},
          "published_at": {"type": "string", "format": "date-time"},
          "modified_at": {"type": "string", "format": "date-time"},
          "category": {"type": "string", "minLength": 1},
          "intent_hint": {"type": "string", "enum": ["explanation", "how_to", "schedule", "comparison"]},
          "freshness_class": {"type": "string", "enum": ["review_required", "time_sensitive_stale", "evergreen_review_due"]},
          "risk_class": {"type": "string", "enum": ["high", "medium", "low"]},
          "action_candidate": {"type": "string", "enum": ["high_risk_review", "refresh_or_retire", "cluster_review"]},
          "link_audit_status": {"type": "string", "const": "not_audited"},
          "media_provenance_status": {"type": "string", "const": "unknown"},
          "evidence_scope": {"type": "string", "const": "public_metadata_only"}
        },
        "required": ["canonical_url", "title", "published_at", "modified_at", "category", "intent_hint", "freshness_class", "risk_class", "action_candidate", "link_audit_status", "media_provenance_status", "evidence_scope"]
      }
    }
  },
  "required": ["schema_version", "classification_version", "inventory_id", "blog_url", "checked_date", "status", "post_count", "external_write_count", "style_analysis_performed", "summary", "posts"]
}
