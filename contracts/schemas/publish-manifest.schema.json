{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tistory-growth-os:schema:publish-manifest:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^manifest_[a-f0-9]{16,64}$"},
    "package_id": {"type": "string", "pattern": "^package_[a-f0-9]{16,64}$"},
    "draft_id": {"type": "string", "pattern": "^draft_[a-f0-9]{16,64}$"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "body_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "policy_snapshot_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "publish_mode": {"type": "string", "const": "approval_required"},
    "state": {"type": "string", "const": "ready_for_approval"},
    "external_write_count": {"type": "integer", "const": 0},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1},
          "media_type": {"type": "string", "minLength": 1},
          "byte_count": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "schema_version": {"type": "string", "const": "1.0.0"}
        },
        "required": ["name", "relative_path", "media_type", "byte_count", "sha256", "schema_version"]
      }
    },
    "pending_owner_decision_ids": {"type": "array", "items": {"type": "string", "pattern": "^ODR-[0-9]{3}$"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "required": ["schema_version", "manifest_id", "package_id", "draft_id", "idempotency_key", "body_hash", "policy_snapshot_digest", "publish_mode", "state", "external_write_count", "artifacts", "pending_owner_decision_ids", "created_at"]
}
