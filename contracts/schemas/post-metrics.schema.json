{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tistory-growth-os:schema:post-metrics:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "metrics_id": {"type": "string", "pattern": "^metrics_[a-z0-9_-]{3,64}$"},
    "post_id": {"type": "string", "pattern": "^post_[a-z0-9_-]{3,64}$"},
    "source": {"type": "string", "enum": ["tistory", "google_search_console", "naver_search_advisor", "adsense", "owner"]},
    "surface": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["unknown", "unauthorized", "observed"]},
    "interval_start": {"type": "string", "format": "date"},
    "interval_end": {"type": "string", "format": "date"},
    "update_basis_date": {"type": "string", "format": "date"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "retention_days": {"type": "integer", "minimum": 0},
    "is_truncated": {"type": "boolean"},
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "value": {"type": "number", "minimum": 0},
          "unit": {"type": "string", "minLength": 1}
        },
        "required": ["metric", "value", "unit"]
      }
    }
  },
  "required": ["schema_version", "metrics_id", "post_id", "source", "surface", "status", "interval_start", "interval_end", "update_basis_date", "ingested_at", "retention_days", "is_truncated", "values"]
}
