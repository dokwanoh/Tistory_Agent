{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tistory-growth-os:schema:article-draft:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "draft_id": {"type": "string", "pattern": "^draft_[a-f0-9]{16,64}$"},
    "brief_id": {"type": "string", "pattern": "^brief_[a-f0-9]{16,64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "section_id": {"type": "string", "pattern": "^section_[a-z0-9_-]{3,64}$"},
          "heading": {"type": "string", "minLength": 1},
          "body": {"type": "string", "minLength": 1},
          "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^claim_[a-z0-9_-]{3,64}$"}},
          "source_evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^src_[a-z0-9_-]{3,64}$"}}
        },
        "required": ["section_id", "heading", "body", "claim_ids", "source_evidence_ids"]
      }
    },
    "quality_status": {"type": "string", "enum": ["not_evaluated", "pass", "blocked"]},
    "as_of": {"type": "string", "format": "date"}
  },
  "required": ["schema_version", "draft_id", "brief_id", "version", "title", "summary", "sections", "quality_status", "as_of"]
}
