{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tistory-growth-os:schema:policy-evidence:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "policy_id": {"type": "string", "pattern": "^POL-[0-9]{3}$"},
    "platform": {"type": "string", "enum": ["tistory", "google_search", "naver_search", "adsense", "kftc", "privacy"]},
    "source_url": {"type": "string", "format": "uri"},
    "source_title": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "enum": ["official", "primary", "secondary"]},
    "checked_at": {"type": "string", "format": "date-time"},
    "effective_date": {"type": "string", "format": "date"},
    "rule_summary": {"type": "string", "minLength": 1},
    "implementation_control_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
  },
  "required": ["schema_version", "policy_id", "platform", "source_url", "source_title", "authority", "checked_at", "effective_date", "rule_summary", "implementation_control_ids", "confidence"]
}
