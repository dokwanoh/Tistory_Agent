{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tistory-growth-os:schema:experiment:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "experiment_id": {"type": "string", "pattern": "^exp_[a-z0-9_-]{3,64}$"},
    "post_ids": {"type": "array", "items": {"type": "string", "pattern": "^post_[a-z0-9_-]{3,64}$"}, "minItems": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "controllable_factor": {"type": "string", "minLength": 1},
    "primary_metric": {"type": "string", "minLength": 1},
    "acceptance_threshold": {"type": "number"},
    "status": {"type": "string", "enum": ["proposed", "shadow", "canary", "promoted", "rejected", "rolled_back"]},
    "started_at": {"type": "string", "format": "date-time"},
    "observation_end": {"type": "string", "format": "date-time"},
    "rollback_condition": {"type": "string", "minLength": 1}
  },
  "required": ["schema_version", "experiment_id", "post_ids", "hypothesis", "controllable_factor", "primary_metric", "acceptance_threshold", "status", "started_at", "observation_end", "rollback_condition"]
}
