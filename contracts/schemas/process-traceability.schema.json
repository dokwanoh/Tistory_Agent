{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tistory-growth-os:schema:process-traceability:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "as_of": {"type": "string", "format": "date"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "as_is_id": {"type": "string", "pattern": "^ASIS-[0-9]{3}$"},
          "problem_or_opportunity": {"type": "string", "minLength": 1},
          "bdw_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "erask_code": {"type": "string", "enum": ["E", "R", "A", "S", "K", "C"]},
          "to_be_id": {"type": "string", "pattern": "^TOBE-[0-9]{3}$"},
          "automation_level": {"type": "string", "enum": ["manual", "assisted", "automated_offline", "approval_gated", "future"]},
          "human_responsibility": {"type": "string", "minLength": 1},
          "test_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "kpi_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
          "risk_controls": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
        },
        "required": ["as_is_id", "problem_or_opportunity", "bdw_evidence", "erask_code", "to_be_id", "automation_level", "human_responsibility", "test_ids", "kpi_ids", "risk_controls"]
      }
    }
  },
  "required": ["schema_version", "as_of", "mappings"]
}
